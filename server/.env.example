# 复制为 .env 后填写，不要提交到 GitHub
# iPhone 推送 Apple Watch 数据用的口令，可用 `openssl rand -hex 24` 生成
INGEST_TOKEN=
# 打开网页时输入的家庭密码（用户名随便填）
PAGE_PASSWORD=
# Tailscale 账号 → 成员，多个用逗号分隔，例如 alice@example.com=me,mom@example.com=mom；* 表示默认成员
FREEREPS_MEMBERS=*=me
# health4.ai 登录邮箱 → 成员，多个用逗号分隔；密码就是 INGEST_TOKEN
H4_ACCOUNTS=me@example.com=me
# 没带时区的时间按这个时区归日（东八区填 8）
TZ_OFFSET_HOURS=8
